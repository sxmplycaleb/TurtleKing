<?xml version="1.0" encoding="utf-8"?>
<!-- Turtle King branded launch splash screen (API 21+) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <!-- The full Turtle King artwork, centered and unscaled so the emblem
         and banner keep their original proportions. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/turtle_king_splash" />
    </item>
</layer-list>
